                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
                        <div class="p-5 rounded-2xl bg-[#f9fbfd] border border-slate-100 flex items-start gap-4">
                            <div class="w-3 h-3 rounded-full bg-[#12519C] mt-1.5 flex-shrink-0"></div>
                            <div>
                                <h4 class="font-bold text-[#12519C]">Empathy</h4>
                                <p class="text-xs text-slate-500 mt-1">Understanding student struggles through open dialogue.</p>
                            </div>
                        </div>

                        <div class="p-5 rounded-2xl bg-[#f9fbfd] border border-slate-100 flex items-start gap-4">
                            <div class="w-3 h-3 rounded-full bg-[#27A0DB] mt-1.5 flex-shrink-0"></div>
                            <div>
                                <h4 class="font-bold text-[#12519C]">Inclusivity</h4>
                                <p class="text-xs text-slate-500 mt-1">Welcoming every voice regardless of background.</p>
                            </div>
                        </div>

                        <div class="p-5 rounded-2xl bg-[#f9fbfd] border border-slate-100 flex items-start gap-4">
                            <div class="w-3 h-3 rounded-full bg-[#F6C401] mt-1.5 flex-shrink-0"></div>
                            <div>
                                <h4 class="font-bold text-[#12519C]">Early Intervention</h4>
                                <p class="text-xs text-slate-500 mt-1">Connecting students to support before issues escalate.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: GET HELP -->
        <section id="get-help" class="py-16 bg-[#f9fbfd] border-t border-slate-100">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <h2 class="text-3xl sm:text-4xl font-bold text-[#12519C] mb-3">Get Help</h2>
                    <p class="text-slate-600 text-lg">We are here to support you anytime you feel unsafe or overwhelmed.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <!-- Left: Contact Details Card -->
                    <div class="lg:col-span-5 bg-white p-8 rounded-3xl border border-slate-100 shadow-md space-y-6">
                        <div>
                            <span class="inline-block px-3 py-1 bg-[#27A0DB]/10 text-[#12519C] font-bold text-xs rounded-full uppercase tracking-wider mb-2">School Counselor</span>
                            <h3 class="text-2xl font-bold text-[#12519C]">If you don't feel safe, talk to counselor Tom.</h3>
                            <p class="text-slate-500 text-sm mt-1">Counselor Tom is available during school hours for confidential consultations.</p>
                        </div>

                        <div class="space-y-4 pt-2">
                            <!-- Email Link -->
                            <a href="mailto:SSH@gmail.com" class="flex items-center gap-4 p-4 rounded-xl bg-[#f9fbfd] hover:bg-slate-100 transition-colors border border-slate-100 group">
                                <div class="w-12 h-12 rounded-lg bg-[#27A0DB] text-white flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-slate-400 uppercase">Email Us</div>
                                    <div class="text-base font-bold text-[#12519C]">SSH@gmail.com</div>
                                </div>
                            </a>

                            <!-- Phone Link -->
                            <a href="tel:38723287" class="flex items-center gap-4 p-4 rounded-xl bg-[#f9fbfd] hover:bg-slate-100 transition-colors border border-slate-100 group">
                                <div class="w-12 h-12 rounded-lg bg-[#12519C] text-white flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-slate-400 uppercase">Direct Line</div>
                                    <div class="text-base font-bold text-[#12519C]">3872-3287</div>
                                </div>
                            </a>
                        </div>

                        <!-- Emergency Alert Box -->
                        <div class="p-5 rounded-2xl bg-amber-50 border-2 border-[#F6C401] flex items-center justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 bg-[#F6C401] text-slate-900 font-extrabold text-xs rounded">URGENT</span>
                                    <h4 class="font-bold text-slate-900">Immediate Crisis?</h4>
                                </div>
                                <p class="text-xs text-slate-600 mt-1">If you or someone else is in immediate danger:</p>
                            </div>
                            <div class="text-right">
                                <span class="block text-2xl font-black text-red-600">Emergency: 911</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Quick Contact / Message Form -->
                    <div class="lg:col-span-7 bg-white p-8 rounded-3xl border border-slate-100 shadow-md">
