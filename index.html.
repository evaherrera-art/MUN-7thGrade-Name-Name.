                        <p class="text-slate-500 text-sm mb-6">Feel free to ask a question, request a meeting, or leave an anonymous message.</p>

                        <!-- Notification Alert Box (Replacing alert()) -->
                        <div id="form-notification" class="hidden mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium">
                            ✓ Your message has been sent to Counselor Tom. We will get back to you as soon as possible.
                        </div>

                        <form id="contact-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
                            <div>
                                <label for="student-name" class="block text-sm font-semibold text-slate-700 mb-1">Your Name (Optional)</label>
                                <input type="text" id="student-name" placeholder="Leave blank for anonymous note" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#27A0DB] focus:border-transparent transition-all">
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="student-grade" class="block text-sm font-semibold text-slate-700 mb-1">Grade / Class</label>
                                    <select id="student-grade" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#27A0DB] focus:border-transparent transition-all">
                                        <option value="">Select Grade</option>
                                        <option value="7">Grade 7</option>
                                        <option value="8">Grade 8</option>
                                        <option value="9">Grade 9</option>
                                        <option value="10">Grade 10</option>
                                        <option value="11">Grade 11</option>
                                        <option value="12">Grade 12</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="contact-method" class="block text-sm font-semibold text-slate-700 mb-1">Contact Back Via</label>
                                    <select id="contact-method" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#27A0DB] focus:border-transparent transition-all">
                                        <option value="email">Email</option>
                                        <option value="in-person">In-Person at School</option>
                                        <option value="none">No Response Needed (Anonymous Note)</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label for="student-message" class="block text-sm font-semibold text-slate-700 mb-1">How can we help you? *</label>
                                <textarea id="student-message" rows="4" required placeholder="Write your message or story here..." class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#27A0DB] focus:border-transparent transition-all"></textarea>
                            </div>

                            <button type="submit" class="w-full py-4 rounded-xl bg-[#27A0DB] hover:bg-[#12519C] text-white font-bold text-base shadow-md hover:shadow-lg transition-all">
                                Send Message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- SECTION 6: FOOTER -->
    <footer class="bg-white border-t border-slate-200 py-8">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <div class="flex justify-center items-center space-x-2 mb-3">
                <div class="w-2.5 h-2.5 rounded-full bg-[#12519C]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#27A0DB]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#F6C401]"></div>
            </div>
            <p class="text-slate-600 font-semibold text-sm">
                Golden Valley School, 2026
            </p>
            <p class="text-xs text-slate-400 mt-1">
                Safe Spaces Student Initiative &bull; Promoting Youth Mental Health & Care
            </p>
        </div>
    </footer>

    <script>
        // Mobile Navigation Menu Toggle Logic
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIconOpen = document.getElementById('menu-icon-open');
        const menuIconClose = document.getElementById('menu-icon-close');
        const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

        function toggleMobileMenu() {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
                mobileMenu.classList.remove('hidden');
                menuIconOpen.classList.add('hidden');
                menuIconClose.classList.remove('hidden');
            } else {
                mobileMenu.classList.add('hidden');
                menuIconOpen.classList.remove('hidden');
                menuIconClose.classList.add('hidden');
            }
        }

        mobileMenuBtn.addEventListener('click', toggleMobileMenu);

        // Close mobile menu when clicking any nav link
        mobileNavLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (!mobileMenu.classList.contains('hidden')) {
                    toggleMobileMenu();
                }
            });
        });

        // Safe Contact Form Handler without alert()
        function handleFormSubmit(e) {
            e.preventDefault();
            const notification = document.getElementById('form-notification');
            const form = document.getElementById('contact-form');
            
            notification.classList.remove('hidden');
            form.reset();

            // Smooth scroll up to notification
            notification.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            // Auto hide notification after 6 seconds
            setTimeout(() => {
                notification.classList.add('hidden');
            }, 6000);
        }

        // Initialize Chart.js Graphs on DOM Content Loaded
        document.addEventListener('DOMContentLoaded', function() {
            // Chart 1: Men
            const ctxMen = document.getElementById('chartMen').getContext('2d');
            new Chart(ctxMen, {
                type: 'bar',
                data: {
                    labels: ['10-14', '15-19', '20-24', '25-34', '35+'],
                    datasets: [{
                        label: '% Affected in Men',
                        data: [12, 28, 22, 18, 14],
                        backgroundColor: '#12519C',
                        borderRadius: 6,
                        hoverBackgroundColor: '#27A0DB'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#12519C',
                            titleFont: { family: 'Arial' },
                            bodyFont: { family: 'Arial' },
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + '% affected';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 35,
                            ticks: {
                                callback: function(value) { return value + '%'; },
                                font: { family: 'Arial', size: 10 }
                            },
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            ticks: { font: { family: 'Arial', size: 10 } },
                            grid: { display: false }
                        }
                    }
                }
            });

            // Chart 2: Women
            const ctxWomen = document.getElementById('chartWomen').getContext('2d');
            new Chart(ctxWomen, {
                type: 'bar',
                data: {
                    labels: ['10-14', '15-19', '20-24', '25-34', '35+'],
                    datasets: [{
                        label: '% Affected in Women',
                        data: [16, 34, 25, 20, 15],
                        backgroundColor: '#27A0DB',
                        borderRadius: 6,
                        hoverBackgroundColor: '#12519C'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#12519C',
                            titleFont: { family: 'Arial' },
                            bodyFont: { family: 'Arial' },
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + '% affected';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 40,
                            ticks: {
                                callback: function(value) { return value + '%'; },
                                font: { family: 'Arial', size: 10 }
                            },
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            ticks: { font: { family: 'Arial', size: 10 } },
                            grid: { display: false }
                        }
                    }
                }
            });

            // Chart 3: World Data
            const ctxWorld = document.getElementById('chartWorld').getContext('2d');
            new Chart(ctxWorld, {
                type: 'doughnut',
                data: {
                    labels: ['North America', 'Latin America', 'Europe', 'Asia-Pacific', 'Africa'],
                    datasets: [{
                        data: [24, 28, 22, 16, 10],
                        backgroundColor: [
                            '#12519C',
                            '#27A0DB',
                            '#F6C401',
                            '#64748b',
                            '#94a3b8'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: { family: 'Arial', size: 10 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ' + context.label + ': ' + context.parsed + '% rate';
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        });
    </script>
</body>
</html>
