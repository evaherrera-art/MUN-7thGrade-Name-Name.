                            </div>
                            <h4 class="text-xl font-bold text-[#12519C] mb-3">3. Support & Empathy</h4>
                            <p class="text-slate-600 leading-relaxed">
                                A compassionate environment providing actionable guidance, active counseling, and reliable school resources.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4: ABOUT US -->
        <section id="about" class="py-16 bg-white border-t border-slate-100">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl mx-auto text-center">
