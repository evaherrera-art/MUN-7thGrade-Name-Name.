                        </div>
                    </div>

                    <!-- Chart 2: Women -->
                    <div class="bg-[#f9fbfd] p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="font-bold text-[#12519C] text-base">Prevalence in Women</h3>
                                <span class="bg-[#27A0DB]/10 text-[#12519C] text-xs font-bold px-2.5 py-1 rounded-full">Sample Data</span>
                            </div>
                            <p class="text-xs text-slate-500 mb-4">Percentage affected across age brackets</p>
                            <div class="chart-container">
                                <canvas id="chartWomen"></canvas>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-200 text-xs text-slate-500">
                            Higher early reported rates; benefit greatly from peer support.
                        </div>
                    </div>

                    <!-- Chart 3: World Data -->
                    <div class="bg-[#f9fbfd] p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="font-bold text-[#12519C] text-base">Global Regional Prevalence</h3>
                                <span class="bg-[#27A0DB]/10 text-[#12519C] text-xs font-bold px-2.5 py-1 rounded-full">Sample Data</span>
