                    <p class="mt-3 text-slate-600 text-lg">Understanding how emotional challenges affect youth across demographics helps create targeted support systems.</p>
                </div>

                <!-- 3 Charts Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Chart 1: Men -->
